<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Micro de l'écran verrouillé : service de premier plan typé `microphone` (Android 14+),
         réveil partiel pendant la capture, et notification visible sur l'écran de verrouillage. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Device Access Toolkit (lunettes Ray-Ban Meta) : lien Bluetooth vers l'app Meta AI. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Banc lunettes : la voix est routée vers la sortie des lunettes (setPreferredDevice, A2DP/BLE). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:name=".SamApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sam3Vision">

        <!-- Wearables Developer Center : « 0 »/« 0 » = Developer Mode (pas d'attestation).
             Valeurs injectées par Gradle depuis local.properties. -->
        <meta-data
            android:name="com.meta.wearable.mwdat.APPLICATION_ID"
            android:value="${mwdat_application_id}" />
        <meta-data
            android:name="com.meta.wearable.mwdat.CLIENT_TOKEN"
            android:value="${mwdat_client_token}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Sam3Vision">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Retour d'enregistrement / d'invocation vocale depuis l'app Meta AI. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="samvision" />
            </intent-filter>
        </activity>

        <!-- Micro mains libres de l'écran verrouillé : armé par l'activité visible, piloté
             ensuite par l'action de la notification ou la tuile des réglages rapides. -->
        <service
            android:name=".locked.LockedMicService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".locked.LockedMicTile"
            android:exported="true"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:label="iSee micro"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>