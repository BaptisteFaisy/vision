<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS partout, release comprise : aucun trafic en clair ici.
  L'exception vers les bacs d'essai locaux (10.0.2.2, localhost, 127.0.0.1)
  vit dans `src/debug/res/xml/network_security.xml`, qui recouvre ce fichier
  en build debug (recouvrement de source-set : même chemin relatif).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>