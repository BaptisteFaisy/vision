#!/bin/sh
# pre-push — la branche part TOUJOURS à jour de origin/master (v1, 2026-11-01)
#
# Pourquoi (mesuré le 01/11/2026 sur BaptisteFaisy/vision) :
#   - `master` reçoit ~300 commits par jour (~12 par heure) ; sur les 250
#     dernières PR fusionnées, une PR ouverte pendant ≥ 5 commits de `master`
#     conflicte dans 15 % des cas, contre 4 % en dessous (`tools/pr-conflits.py`
#     pour rejouer la mesure) ;
#   - 24 % des PR (10 sur 42 en 4 h de balayage) arrivent avec une base déjà
#     périmée : le balayeur doit les rebaser, et une sur deux finit chez l'agent
#     de conflit — ≈ 15 min de boucle LLM + un passage de CI complet.
# Rebaser AVANT le push ramène ce coût à ~1 s : la branche part à jour, c'est
# l'auteur qui voit le conflit (avec le code sous les yeux, dans son contexte),
# et le balayeur n'a plus rien à rattraper.
#
# Ce que le hook ne fait JAMAIS :
#   - un rebase d'un push forcé (le bail `--force-with-lease` du balayeur et de
#     l'agent de conflit doit rester intact) ;
#   - un rebase de `master` ou des branches de file `mergify/merge-queue/*` ;
#   - un rebase dans un arbre sale : on prévient, on ne bloque pas (un hook ne
#     casse pas un travail en cours) ;
#   - bloquer une suppression de branche ou un push de tag.
#
# Sortie : 0 = push continue (branche à jour ou rebasée), 1 = push bloqué parce
# que le rebase conflicte — l'auteur résout, puis repousse.
# Drapeau : VISION_NO_FRESH_PUSH=1 pour pousser sans rebase (dépannage).

[ "${VISION_NO_FRESH_PUSH:-0}" = "1" ] && exit 0

Z40=0000000000000000000000000000000000000000
RACINE=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Rien à faire hors du dépôt vision (le hook peut être installé globalement).
case "$(git remote get-url origin 2>/dev/null)" in
  *BaptisteFaisy/vision*) ;;
  *) exit 0 ;;
esac

BRANCHE=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
[ -n "$BRANCHE" ] || exit 0
case "$BRANCHE" in
  master | mergify/*) exit 0 ;;
esac

# Le flux du hook : <sha local> <sha local> <ref distante> <sha distante>.
POUSSEE=0
while read -r _lref lsha rref rsha; do
  case "$rref" in
    refs/heads/master | refs/heads/mergify/*) continue ;;
    refs/heads/"$BRANCHE") ;;
    *) continue ;;
  esac
  [ "$lsha" = "$Z40" ] && continue                    # suppression de branche
  if [ -n "$rsha" ] && [ "$rsha" != "$Z40" ]; then    # branche déjà distante
    # Push forcé (réécriture d'historique par le balayeur) : on ne touche à rien,
    # un rebase invaliderait le bail et écraserait le travail d'un autre agent.
    if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
      echo "pre-push : push forcé de $BRANCHE — rebase sauté (réécriture volontaire)"
      exit 0
    fi
  fi
  POUSSEE=1
done
[ "$POUSSEE" = 1 ] || exit 0

if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
  echo "pre-push : arbre sale — rebase sauté (commitez d'abord pour partir à jour)"
  exit 0
fi

t0=$(date +%s%N 2>/dev/null || echo 0)

# Fetch ciblé sur master seulement : quelques dizaines de Ko, pas un fetch complet.
if ! git fetch --quiet --no-tags --prune origin \
      "+refs/heads/master:refs/remotes/origin/master" 2>/dev/null; then
  echo "pre-push : fetch impossible (hors ligne ?) — push tel quel"
  exit 0
fi

DERRIERE=$(git rev-list --count "HEAD..origin/master" 2>/dev/null || echo 0)
# Branche non linéaire (`master` mergé au lieu d'être rebasé) : la file de merge
# la refuse (`GITHUB_REBASE_MERGE_REFUSED`) et le balayeur doit la linéariser.
# Le rebase ci-dessous la remet à plat du même geste — coût nul.
MERGES=$(git rev-list --count --merges "origin/master..HEAD" 2>/dev/null || echo 0)
if [ "$DERRIERE" = 0 ] && [ "$MERGES" = 0 ]; then
  exit 0                                              # cas courant : rien à faire
fi

if ! git rebase --quiet origin/master >/dev/null 2>&1; then
  FICHIERS=$(git diff --name-only --diff-filter=U 2>/dev/null | tr '\n' ' ')
  git rebase --abort >/dev/null 2>&1
  cat >&2 <<EOF
pre-push : CONFLIT avec master — push bloqué (branche $DERRIERE commits en retard, $MERGES commit(s) de merge).
  Fichiers en conflit : ${FICHIERS:-inconnus}
  À faire :  git fetch origin && git rebase origin/master
             (résoudre, git add, git rebase --continue), puis repousser.
  Pour pousser quand même : VISION_NO_FRESH_PUSH=1 git push ...
EOF
  exit 1
fi

t1=$(date +%s%N 2>/dev/null || echo 0)
MS=$(( (t1 - t0) / 1000000 ))
if [ "$MERGES" != 0 ] && [ "$DERRIERE" = 0 ]; then
  echo "pre-push : $BRANCHE linéarisée (remise à plat sur master, ${MS} ms)"
else
  echo "pre-push : $BRANCHE rebasée sur master ($DERRIERE commits absorbés, ${MS} ms)"
fi
exit 0
